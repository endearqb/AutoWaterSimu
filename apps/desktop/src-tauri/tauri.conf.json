{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoWaterSimu Next Desktop",
  "version": "0.1.0",
  "identifier": "com.autowatersimu.next.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoWaterSimu Next",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
