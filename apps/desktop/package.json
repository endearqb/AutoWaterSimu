{
  "name": "autowatersimu-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "release:build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-packaged-sidecar.ps1",
    "release:build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-nsis-installer.ps1",
    "release:smoke:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-sidecar.ps1",
    "release:smoke:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-nsis-installer.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "typescript": "^5.2.2",
    "vite": "^6.3.4"
  }
}
