          "max_value": { "type": "number" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelParameterSet": {
        "type": "object",
        "required": ["parameter_set_id", "status", "parameter_hash"],
        "properties": {
          "parameter_set_id": { "type": "string" },
