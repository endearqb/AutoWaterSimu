          "model_key": { "type": "string" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "supported_job_types": { "type": "array", "items": { "type": "string" } },
          "versions": { "type": "array", "items": { "$ref": "#/components/schemas/ModelCatalogVersion" } },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelCatalogVersion": {
        "type": "object",
        "required": ["model_version", "status", "runtime", "parameter_templates", "benchmark_cases"],
