          "model_version": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "deprecated", "archived"] },
          "runtime": { "type": "string" },
          "released_at": { "type": "string", "format": "date-time" },
          "parameter_templates": { "type": "array", "items": { "$ref": "#/components/schemas/ModelParameterTemplate" } },
          "benchmark_cases": { "type": "array", "items": { "$ref": "#/components/schemas/ModelBenchmarkCase" } },
          "default_parameter_set": { "$ref": "#/components/schemas/ModelParameterSet" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelBenchmarkCase": {
        "type": "object",
        "required": ["benchmark_case_id", "display_name", "job_type", "input_ref", "expected_metrics", "tolerance", "status"],
        "properties": {
          "benchmark_case_id": { "type": "string" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "job_type": { "type": "string" },
          "input_ref": { "type": "object", "additionalProperties": true },
          "expected_metrics": { "type": "object", "additionalProperties": true },
          "tolerance": { "type": "object", "additionalProperties": true },
          "status": { "type": "string", "enum": ["draft", "validated", "retired"] },
          "source": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelParameterTemplate": {
        "type": "object",
        "required": ["parameter_key", "display_name", "value_type", "required"],
