          "parameter_hash": { "type": "string" },
          "parameters": { "type": "object", "additionalProperties": true },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelRun": { "type": "object", "additionalProperties": true },
      "EvidencePackage": { "type": "object", "additionalProperties": true },
      "JobSnapshot": {
        "type": "object",
        "required": ["job", "artifacts", "event_count"],
        "properties": {
          "job": { "$ref": "#/components/schemas/JobRecord" },
          "artifacts": { "type": "array", "items": { "$ref": "#/components/schemas/ArtifactRecord" } },
          "event_count": { "type": "integer" }
        }
      },
      "ListJobsResponse": {
        "type": "object",
        "required": ["items", "total_estimate"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/JobSnapshot" } },
