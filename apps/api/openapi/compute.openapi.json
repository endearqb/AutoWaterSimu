          "generated_at": { "type": "string", "format": "date-time" },
          "models": { "type": "array", "items": { "$ref": "#/components/schemas/ModelCatalogModel" } },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ModelCatalogRecord": {
        "type": "object",
        "required": ["catalog_id", "schema_version", "generated_at", "payload_hash", "payload", "source_system", "requested_by", "created_at"],
