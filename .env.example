# 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改配置值

# 环境配置
ENVIRONMENT=local  # local, development, staging, production
# AutoWaterSimu Next Compute API reads APP_ENV first and falls back to ENVIRONMENT.
# production 会禁止空 COMPUTE_API_TOKENS_JSON 以及默认 dev token。
APP_ENV=local
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173

# 安全配置
SECRET_KEY=your-secret-key-here  # 生产环境请使用强密码
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://localhost:5173","http://localhost","https://localhost"]

# 数据库配置
POSTGRES_SERVER=localhost  # 数据库服务器地址
POSTGRES_PORT=5433         # 数据库端口
POSTGRES_DB=autowatersimu  # 数据库名称
POSTGRES_USER=postgres     # 数据库用户名
POSTGRES_PASSWORD=dataanalysis123 # 数据库密码

# 超级用户配置
FIRST_SUPERUSER=admin@example.com  # 初始管理员邮箱
FIRST_SUPERUSER_PASSWORD=changethis  # 初始管理员密码

# 项目配置
PROJECT_NAME="数据分析工具"

# 邮件配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
EMAILS_FROM_EMAIL=noreply@example.com

# 监控配置 (可选)
SENTRY_DSN=your_sentry_dsn_here

# 开发模式配置
DEBUG=false  # 生产环境设为 false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Legacy 计算迁移收口配置
# 默认 false，保持旧 FastAPI 计算入口可作为 baseline 使用。
# 仅当 Next worker/API 路径已完成迁移并进入只读对照期时设为 true。
LEGACY_COMPUTE_READ_ONLY=false

# AutoWaterSimu Next Compute API 本地开发配置
# docker-compose.dev.yml 默认使用独立的 compose service DNS；本机直接运行时可改为 localhost。
COMPUTE_API_PORT=8088
COMPUTE_API_DATABASE_URL=postgres://autowatersimu:autowatersimu@localhost:5434/autowatersimu_compute?sslmode=disable
COMPUTE_API_ARTIFACT_DIR=tmp/compute-api-artifacts
COMPUTE_API_TOKENS_JSON={"tokens":[{"name":"dev-public","token":"dev-public-token","scopes":["job:create","job:read","artifact:read","evidence:read","model:write","explanation:write"]},{"name":"dev-worker","token":"dev-worker-token","scopes":["worker:register","worker:claim","worker:heartbeat","job:write","artifact:write"]},{"name":"dev-admin","token":"dev-admin-token","scopes":["job:create","job:read","artifact:read","artifact:write","artifact:admin","evidence:read","model:write","explanation:write"]}]}

# AutoWaterSimu Next S3-compatible archive dev backend (MinIO)
COMPUTE_API_ARCHIVE_S3_ENDPOINT=http://localhost:9000
COMPUTE_API_ARCHIVE_S3_BUCKET=autowatersimu-archive
COMPUTE_API_ARCHIVE_S3_REGION=us-east-1
COMPUTE_API_ARCHIVE_S3_ACCESS_KEY_ID=minioadmin
COMPUTE_API_ARCHIVE_S3_SECRET_ACCESS_KEY=minioadmin
COMPUTE_API_ARCHIVE_S3_PREFIX=compute-api/dev

# AutoWaterSimu Next frontend/worker dev defaults
VITE_COMPUTE_API_URL=http://localhost:8088
VITE_COMPUTE_API_TOKEN=dev-public-token
SIMULATION_WORKER_API_BASE_URL=http://localhost:8088
SIMULATION_WORKER_API_TOKEN=dev-worker-token
