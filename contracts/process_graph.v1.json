{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "process_graph.v1.json",
  "title": "process_graph.v1",
  "type": "object",
  "required": [
    "schema_version",
    "process_graph_id",
    "version",
    "source_canvas_graph_id",
    "component_schema",
    "nodes",
    "edges",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "process_graph.v1" },
    "process_graph_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "source_canvas_graph_id": { "type": "string", "minLength": 1 },
    "component_schema": {
      "type": "object",
      "required": ["component_schema_id", "components", "unit"],
      "properties": {
        "component_schema_id": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "process_unit_type", "ports", "model_binding", "unit_metadata"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "node_type": { "type": "string", "minLength": 1 },
          "process_unit_type": { "type": "string", "minLength": 1 },
          "ports": { "type": "array", "items": { "type": "object" } },
          "volume": { "type": "number", "minimum": 0 },
          "initial_conditions": { "type": "object" },
          "model_binding": { "type": "object" },
          "parameter_binding": { "type": "object" },
          "unit_metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "source_node_id",
          "target_node_id",
          "source_port",
          "target_port",
          "flow_rate",
          "concentration_transform"
        ],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "source_node_id": { "type": "string", "minLength": 1 },
          "target_node_id": { "type": "string", "minLength": 1 },
          "source_port": { "type": "string", "minLength": 1 },
          "target_port": { "type": "string", "minLength": 1 },
          "flow_rate": { "type": "number", "minimum": 0 },
          "concentration_transform": { "type": "object" },
          "time_segment_overrides": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": { "const": "valid" },
        "errors": { "type": "array", "maxItems": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
