{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation_request.v1.json",
  "title": "simulation_request.v1",
  "type": "object",
  "required": ["schema_version", "request_id", "source_system", "requested_by", "job_type", "input_ref"],
  "properties": {
    "schema_version": { "const": "simulation_request.v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "job_type": {
      "type": "string",
      "enum": [
        "simulation.material_balance.v1",
        "simulation.asm1slim.v1",
        "simulation.asm1.v1",
        "simulation.asm3.v1",
        "simulation.udm.v1"
      ]
    },
    "input_ref": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "process_graph_id": { "type": "string", "minLength": 1 },
        "process_graph_version": { "type": "integer", "minimum": 1 },
        "simulation_input_id": { "type": "string", "minLength": 1 },
        "model_run_id": { "type": "string", "minLength": 1 },
        "simulation_input": { "type": "object" }
      },
      "additionalProperties": true
    },
    "external_refs": {
      "type": "object",
      "properties": {
        "site_id": { "type": "string", "minLength": 1 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "source_system": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string" },
        "project_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
