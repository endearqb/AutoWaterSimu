{
  "schema_version": "contracts_registry.v1",
  "updated_on": "2026-06-14",
  "description": "Registry for AutoWaterSimu Next JSON Schema contracts, examples, consumers, and compatibility policy.",
  "current_drift_gates": [
    "backend/.venv/Scripts/python -m pytest contracts/tests -q",
    "frontend npm run generate-compute-client",
    "git diff --exit-code -- apps/api/openapi/compute.openapi.json frontend/src/client/compute"
  ],
  "breaking_change_policies": {
    "p0_additive_only_v1": "Within a v1 schema, consumers may rely on existing required fields, enum values, and semantics. Removing fields, adding required fields, narrowing enums, changing schema_version, or changing persisted/ref semantics requires a new schema version and coordinated Go API, Python worker, frontend generated client, Desktop, OpenAPI, examples, tests, README, and registry updates. Optional additive fields are allowed only when existing consumers can ignore them safely and examples/tests are updated."
  },
  "contracts": [
