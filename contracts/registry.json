      "schema_file": "agent_scenario_draft.v1.json",
      "consumers": [
        "Go Compute API contract confirmation and promotion endpoints",
        "frontend Compute Jobs contract validation panel",
        "Agent or external draft producers"
      ],
      "valid_examples": [
        "examples/valid/agent_material_balance.agent_scenario_draft.v1.json"
      ],
      "invalid_examples": [],
      "compatibility_notes": "Drafts are advisory until explicitly confirmed and promoted; consumers must not treat a draft as an executable job.",
      "breaking_change_policy": "p0_additive_only_v1"
    },
