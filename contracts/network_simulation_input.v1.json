{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network_simulation_input.v1.json",
  "title": "network_simulation_input.v1",
  "type": "object",
  "$defs": {
    "componentPolicy": {
      "type": "object",
      "required": ["mode", "include", "exclude"],
      "properties": {
        "mode": { "type": "string", "enum": ["all", "include", "exclude"] },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "componentSchema": {
      "type": "object",
      "required": ["component_schema_id", "components", "unit"],
      "properties": {
        "component_schema_id": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unit": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "flowSpec": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fixed", "balanced", "split_fraction", "ratio_to_edge", "residual", "controlled", "timeseries"]
        },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "reference_edge_id": { "type": "string", "minLength": 1 },
        "ratio": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "timeseries_ref": { "type": "string", "minLength": 1 },
        "control_signal": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type", "component_schema_id", "initial_conditions", "model_binding"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "node_type": { "type": "string", "minLength": 1 },
        "process_unit_type": { "type": "string", "minLength": 1 },
        "component_schema_id": { "type": "string", "minLength": 1 },
        "initial_conditions": { "type": "object", "additionalProperties": { "type": "number" } },
        "volume": { "type": "number", "minimum": 0 },
        "ports": { "type": "array", "items": { "type": "object" } },
        "model_binding": {
          "type": "object",
          "required": ["model_kind", "reaction_enabled"],
          "properties": {
            "model_kind": { "type": "string", "minLength": 1 },
            "model_id": { "type": "string", "minLength": 1 },
            "model_version": { "type": "string", "minLength": 1 },
            "model_hash": { "type": "string", "minLength": 1 },
            "reaction_enabled": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "parameter_binding": { "type": "object" },
        "unit_metadata": { "type": "object" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edge_id",
        "edge_kind",
        "source_node_id",
        "source_port",
        "target_node_id",
        "target_port",
        "component_policy"
      ],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "edge_kind": { "type": "string", "enum": ["hydraulic", "pump", "settling", "signal"] },
        "source_node_id": { "type": "string", "minLength": 1 },
        "source_port": { "type": "string", "minLength": 1 },
        "target_node_id": { "type": "string", "minLength": 1 },
        "target_port": { "type": "string", "minLength": 1 },
        "component_policy": { "$ref": "#/$defs/componentPolicy" },
        "stream_adapter": { "type": ["object", "null"] },
        "flow_spec": { "$ref": "#/$defs/flowSpec" },
        "transport_model": { "type": ["object", "null"] },
        "pump": { "type": "object", "additionalProperties": true },
        "signal_spec": { "type": "object", "additionalProperties": true },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "simulation_input_id",
    "job_type",
    "network_graph_id",
    "network_graph_version",
    "component_schemas",
    "nodes",
    "edges",
    "flow_constraints",
    "signal_bindings",
    "parameters",
    "runtime_options"
  ],
  "properties": {
    "schema_version": { "const": "network_simulation_input.v1" },
    "simulation_input_id": { "type": "string", "minLength": 1 },
    "job_type": { "const": "simulation.udm_network.v1" },
    "network_graph_id": { "type": "string", "minLength": 1 },
    "network_graph_version": { "type": "integer", "minimum": 1 },
    "component_schemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentSchema" }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "flow_constraints": { "type": "array", "items": { "type": "object" } },
    "signal_bindings": { "type": "array", "items": { "type": "object" } },
    "parameters": {
      "type": "object",
      "required": ["duration_days", "output_step_days", "solver_backend", "solver_method", "rtol", "atol"],
      "properties": {
        "duration_days": { "type": "number", "exclusiveMinimum": 0 },
        "output_step_days": { "type": "number", "exclusiveMinimum": 0 },
        "solver_backend": { "type": "string", "minLength": 1 },
        "solver_method": { "type": "string", "minLength": 1 },
        "rtol": { "type": "number", "exclusiveMinimum": 0 },
        "atol": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "runtime_options": {
      "type": "object",
      "properties": {
        "strict_flow_balance": { "type": "boolean" },
        "strict_mass_balance": { "type": "boolean" },
        "profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}

