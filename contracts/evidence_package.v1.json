{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_package.v1.json",
  "title": "evidence_package.v1",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_package_id",
    "job_id",
    "input_hash",
    "result_hash",
    "process_graph_ref",
    "simulation_input_ref",
    "model_run_refs",
    "artifact_refs",
    "runtime_audit",
    "warnings",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "evidence_package.v1" },
    "evidence_package_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "result_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "process_graph_ref": { "type": "object" },
    "simulation_input_ref": { "type": "object" },
    "model_run_refs": { "type": "array", "items": { "type": "string" } },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "runtime_audit": { "type": "object" },
    "governance": { "$ref": "#/$defs/governance" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "governance": {
      "type": "object",
      "required": ["production_allowed", "model_version_refs"],
      "properties": {
        "production_allowed": { "type": "boolean" },
        "model_version_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/model_version_ref" }
        }
      },
      "additionalProperties": false
    },
    "model_version_ref": {
      "type": "object",
      "required": [
        "model_run_id",
        "model_key",
        "model_version",
        "parameter_hash",
        "model_status",
        "parameter_set_status",
        "production_allowed"
      ],
      "properties": {
        "model_run_id": { "type": "string", "minLength": 1 },
        "model_key": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "parameter_set_id": { "type": "string" },
        "parameter_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "model_status": { "type": "string", "minLength": 1 },
        "parameter_set_status": { "type": "string", "minLength": 1 },
        "production_allowed": { "type": "boolean" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
