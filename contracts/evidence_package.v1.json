{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_package.v1.json",
  "title": "evidence_package.v1",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_package_id",
    "job_id",
    "input_hash",
    "result_hash",
    "process_graph_ref",
    "simulation_input_ref",
    "model_run_refs",
    "artifact_refs",
    "runtime_audit",
    "warnings",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "evidence_package.v1" },
    "evidence_package_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "result_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "process_graph_ref": { "type": "object" },
    "simulation_input_ref": { "type": "object" },
    "model_run_refs": { "type": "array", "items": { "type": "string" } },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "runtime_audit": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
