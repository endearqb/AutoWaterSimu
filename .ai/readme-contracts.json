{
  "version": 2,
  "exclude_dir_names": [
    "node_modules",
    ".venv",
    "dist",
    "build",
    "coverage",
    ".pytest_cache",
    "tmp",
    "target"
  ],
  "max_lines": {
    "root_contract": 450,
    "contract": 180,
    "pointer": 80,
    "archive": 160,
    "artifact": 140,
    "release": 240,
    "changelog": 100,
    "governance": 240
  },
  "type_rules": [
    { "pattern": "^README(_zh)?\\.md$", "type": "root_contract" },
    { "pattern": "^README_First\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\README\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\architecture\\\\README\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\changes\\\\README\\.md$", "type": "changelog" },
    { "pattern": "^\\.ai\\\\decisions\\\\README\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\plans\\\\README\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\reviews\\\\README\\.md$", "type": "governance" },
    { "pattern": "^\\.ai\\\\(glossary|handoff)\\.md$", "type": "governance" },
    { "pattern": "^docs\\\\rebuild(\\\\|$)", "type": "archive" },
    { "pattern": "^updatenote\\\\README\\.md$", "type": "archive" },
    { "pattern": "^docs\\\\operations(\\\\|$)", "type": "release" },
    { "pattern": "^scripts\\\\release(\\\\|$)", "type": "release" },
    { "pattern": "openapi\\\\README\\.md$", "type": "pointer" },
    { "pattern": "client\\\\README\\.md$", "type": "pointer" },
    { "pattern": "codegen\\\\README\\.md$", "type": "pointer" }
  ],
  "absolute_path_patterns": [
    "[A-Za-z]:\\\\(?:Users|MyProject|Projects|dev|repo)\\\\",
    "/Users/[^\\s)`]+",
    "/home/[^\\s)`]+"
  ],
  "secret_patterns": [
    "sk-[A-Za-z0-9_-]{20,}",
    "ghp_[A-Za-z0-9_]{20,}",
    "xox[baprs]-[A-Za-z0-9-]{20,}",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  ]
}
