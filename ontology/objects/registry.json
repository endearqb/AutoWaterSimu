{
  "schema_version": "ontology_objects_registry.v1",
  "objects": [
    {
      "key": "WaterStation",
      "label": "Water station",
      "description": "A tenant-scoped water or wastewater facility that owns process graphs, units, assets, monitoring points, and operating evidence.",
      "category": "asset",
      "identity": ["tenant_id", "station_id"],
      "required_attributes": ["station_id", "name", "site_id"],
      "relationships": ["station_has_process_graph", "station_has_process_unit"],
      "allowed_actions": ["view", "update_metadata"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["audit_event", "process_graph"]
    },
    {
      "key": "ProcessGraph",
      "label": "Process graph",
      "description": "A structured process topology that can drive simulation input generation and evidence-backed model runs.",
      "category": "process",
      "identity": ["tenant_id", "project_id", "process_graph_id", "version"],
      "required_attributes": ["process_graph_id", "version", "nodes", "edges"],
      "relationships": ["station_has_process_graph", "process_graph_contains_process_unit", "process_graph_drives_compute_job"],
      "allowed_actions": ["view", "update_metadata", "register_process_graph", "approve_agent_draft", "queue_compute_job"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["process_graph", "simulation_input", "audit_event"]
    },
    {
      "key": "ProcessUnit",
      "label": "Process unit",
      "description": "A process step such as a reactor, clarifier, tank, pump, or treatment unit inside a station or graph.",
      "category": "process",
      "identity": ["tenant_id", "site_id", "unit_id"],
      "required_attributes": ["unit_id", "unit_type", "name"],
      "relationships": ["station_has_process_unit", "process_graph_contains_process_unit", "process_unit_has_equipment_asset", "process_unit_has_monitoring_point"],
      "allowed_actions": ["view", "update_metadata"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["audit_event", "process_graph"]
    },
    {
      "key": "EquipmentAsset",
      "label": "Equipment asset",
      "description": "A physical asset such as a blower, mixer, pump, valve, sensor, or control panel.",
      "category": "asset",
      "identity": ["tenant_id", "site_id", "asset_id"],
      "required_attributes": ["asset_id", "asset_type", "name"],
      "relationships": ["process_unit_has_equipment_asset", "work_order_targets_equipment_asset"],
      "allowed_actions": ["view", "update_metadata", "create_work_order"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["audit_event", "work_order"]
    },
    {
      "key": "MonitoringPoint",
      "label": "Monitoring point",
      "description": "A named sampling, sensor, or measurement location attached to a process unit.",
      "category": "quality",
      "identity": ["tenant_id", "site_id", "monitoring_point_id"],
      "required_attributes": ["monitoring_point_id", "name", "parameter_groups"],
      "relationships": ["process_unit_has_monitoring_point", "monitoring_point_has_quality_sample"],
      "allowed_actions": ["view", "update_metadata", "register_sample"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["audit_event", "quality_sample"]
    },
    {
      "key": "WaterQualitySample",
      "label": "Water quality sample",
      "description": "A lab or sensor observation set for a monitoring point and sampling time.",
      "category": "quality",
      "identity": ["tenant_id", "site_id", "sample_id"],
      "required_attributes": ["sample_id", "sampled_at", "measurements"],
      "relationships": ["monitoring_point_has_quality_sample"],
      "allowed_actions": ["view", "register_sample"],
      "read_scope": ["tenant_id", "site_id", "project_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["quality_sample", "audit_event"]
    },
    {
      "key": "ChemicalMaterial",
      "label": "Chemical material",
      "description": "A chemical, reagent, or consumable used by process operation or simulation assumptions.",
      "category": "inventory",
      "identity": ["tenant_id", "site_id", "material_id"],
      "required_attributes": ["material_id", "name", "unit"],
      "relationships": ["chemical_material_has_inventory_balance"],
      "allowed_actions": ["view", "update_metadata", "register_inventory_balance"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["inventory_balance", "audit_event"]
    },
    {
      "key": "InventoryBalance",
      "label": "Inventory balance",
      "description": "A time-bounded balance record for material usage, receipt, adjustment, or forecast.",
      "category": "inventory",
      "identity": ["tenant_id", "site_id", "inventory_balance_id"],
      "required_attributes": ["inventory_balance_id", "material_id", "quantity", "period"],
      "relationships": ["chemical_material_has_inventory_balance"],
      "allowed_actions": ["view", "register_inventory_balance"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["inventory_balance", "audit_event"]
    },
    {
      "key": "WorkOrder",
      "label": "Work order",
      "description": "A planned or corrective action attached to equipment, process operation, or risk mitigation.",
      "category": "work",
      "identity": ["tenant_id", "site_id", "work_order_id"],
      "required_attributes": ["work_order_id", "status", "target"],
      "relationships": ["work_order_targets_equipment_asset", "maintenance_event_closes_work_order"],
      "allowed_actions": ["view", "create_work_order", "close_work_order"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["work_order", "maintenance_event", "audit_event"]
    },
    {
      "key": "MaintenanceEvent",
      "label": "Maintenance event",
      "description": "An executed maintenance or corrective action that may close or update a work order.",
      "category": "work",
      "identity": ["tenant_id", "site_id", "maintenance_event_id"],
      "required_attributes": ["maintenance_event_id", "performed_at", "summary"],
      "relationships": ["maintenance_event_closes_work_order"],
      "allowed_actions": ["view", "record_maintenance_event"],
      "read_scope": ["tenant_id", "site_id"],
      "write_scope": ["tenant_id", "site_id"],
      "evidence_refs": ["maintenance_event", "audit_event"]
    },
    {
      "key": "BenchmarkCase",
      "label": "Benchmark case",
      "description": "A validated reference scenario used to test a model version or parameter set.",
      "category": "model_governance",
      "identity": ["model_key", "model_version", "benchmark_case_id"],
      "required_attributes": ["benchmark_case_id", "status", "expected_outputs"],
      "relationships": ["benchmark_case_validates_model_version"],
      "allowed_actions": ["view", "update_metadata", "queue_compute_job"],
      "read_scope": ["tenant_id", "project_id"],
      "write_scope": ["tenant_id", "project_id"],
      "evidence_refs": ["benchmark_case", "benchmark_run", "audit_event"]
    },
    {
      "key": "ModelVersion",
      "label": "Model version",
      "description": "A governed model release or catalog entry with benchmark and parameter-set context.",
      "category": "model_governance",
      "identity": ["model_key", "model_version"],
      "required_attributes": ["model_key", "model_version", "status"],
      "relationships": ["benchmark_case_validates_model_version", "model_version_has_parameter_set"],
      "allowed_actions": ["view", "register_model_version", "update_metadata"],
      "read_scope": ["tenant_id", "project_id"],
      "write_scope": ["tenant_id", "project_id"],
      "evidence_refs": ["model_catalog", "benchmark_run", "audit_event"]
    },
    {
      "key": "ParameterSet",
      "label": "Parameter set",
      "description": "A versioned model parameter set with lifecycle status and benchmark-backed promotion evidence.",
      "category": "model_governance",
      "identity": ["model_key", "model_version", "parameter_set_id"],
      "required_attributes": ["parameter_set_id", "status", "parameters"],
      "relationships": ["model_version_has_parameter_set", "parameter_set_produces_model_run"],
      "allowed_actions": ["view", "promote_parameter_set"],
      "read_scope": ["tenant_id", "project_id"],
      "write_scope": ["tenant_id", "project_id"],
      "evidence_refs": ["parameter_set", "benchmark_run", "model_run", "audit_event"]
    },
    {
      "key": "ComputeJob",
      "label": "Compute job",
      "description": "A queued or completed computation request owned by the Compute API and processed by a worker.",
      "category": "evidence",
      "identity": ["tenant_id", "project_id", "job_id"],
      "required_attributes": ["job_id", "job_type", "status", "payload"],
      "relationships": ["process_graph_drives_compute_job", "compute_job_produces_model_run", "evidence_package_references_compute_job"],
      "allowed_actions": ["view", "queue_compute_job"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["compute_job", "simulation_input", "audit_event"]
    },
    {
      "key": "ModelRun",
      "label": "Model run",
      "description": "A persisted result summary for a computation, including model, parameter, input, artifact, and quality metadata.",
      "category": "evidence",
      "identity": ["tenant_id", "project_id", "model_run_id"],
      "required_attributes": ["model_run_id", "job_id", "model_key", "status"],
      "relationships": ["parameter_set_produces_model_run", "compute_job_produces_model_run", "evidence_package_summarizes_model_run"],
      "allowed_actions": ["view", "publish_evidence_package"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["model_run", "artifact", "audit_event"]
    },
    {
      "key": "EvidencePackage",
      "label": "Evidence package",
      "description": "A publishable evidence summary that references model runs, artifacts, risks, checks, and governance decisions.",
      "category": "evidence",
      "identity": ["tenant_id", "project_id", "evidence_package_id"],
      "required_attributes": ["evidence_package_id", "job_id", "status"],
      "relationships": ["evidence_package_summarizes_model_run", "evidence_package_references_compute_job", "risk_finding_blocks_evidence_package"],
      "allowed_actions": ["view", "publish_evidence_package"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["evidence_package", "risk_finding", "audit_event"]
    },
    {
      "key": "RiskFinding",
      "label": "Risk finding",
      "description": "A risk, warning, or blocker derived from validation, production readiness, model governance, or operational review.",
      "category": "evidence",
      "identity": ["tenant_id", "project_id", "risk_finding_id"],
      "required_attributes": ["risk_finding_id", "severity", "status", "summary"],
      "relationships": ["risk_finding_blocks_evidence_package"],
      "allowed_actions": ["view", "acknowledge_risk_finding"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["risk_finding", "evidence_package", "audit_event"]
    },
    {
      "key": "AgentDraft",
      "label": "Agent draft",
      "description": "A proposed scenario, process graph, parameter change, or compute request produced by an agent and awaiting explicit human confirmation.",
      "category": "agent",
      "identity": ["tenant_id", "project_id", "draft_id"],
      "required_attributes": ["draft_id", "draft_type", "status", "proposed_request"],
      "relationships": ["agent_draft_proposes_process_graph"],
      "allowed_actions": ["view", "approve_agent_draft"],
      "read_scope": ["tenant_id", "project_id", "site_id"],
      "write_scope": ["tenant_id", "project_id", "site_id"],
      "evidence_refs": ["agent_draft", "draft_confirmation", "audit_event"]
    }
  ]
}
